/* Must equal UDATA_SIZE (UDATA_BLKS << BLKSHIFT) in the platform's
   config.h; main.c checks the two at boot and panics if they differ. */
#define UDATA_SIZE_ASM		(512*12)

#define U_DATA__U_SP_OFFSET 24
#define U_DATA__U_PTAB_OFFSET 0
#define P_TAB__P_PID_OFFSET 4
#define P_TAB__P_STATUS_OFFSET 0
#define P_TAB__P_PAGE_OFFSET 24

#define P_RUNNING 1

