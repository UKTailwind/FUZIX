; UZI mnemonics for memory addresses etc

U_DATA__TOTALSIZE           .equ 0x200        ; 256+256 bytes @0xF200

U_DATA_STASH		    .equ 0xF000	      ; F000-F200

PROGBASE		    .equ 0x0000
PROGLOAD		    .equ 0x0100
PROGTOP				.equ 0xF000

Z80_TYPE		    .equ 1

Z80_MMU_HOOKS		    .equ 0

CONFIG_SWAP		    .equ 1

;
;	Select where to put the high code - in our case we need this
;	in _COMMONMEM
;
.macro HIGH
		.area _COMMONMEM
.endm

; We only have a single page entry

HIGHPAGE		    .equ 0

NBUFS			    .equ 4

DYNAMIC_BUFPOOL		.equ 1

CONFIG_M4BOARD		.equ 1
CONFIG_NET_M4BOARD	.equ 1
CONFIG_FDC765		.equ 0

EOPNOTSUPP			.equ 44		;keep the same as in kernel.h
