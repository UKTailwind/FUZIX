--- hcd_rp2040.c	(TinyUSB 0.21.0, pico-sdk lib/tinyusb)
+++ hcd_rp2040.c	(Pico Computer 3 kernel, usb/hcd_rp2040.patch)
@@ -31,6 +31,7 @@
 #if CFG_TUH_ENABLED && (CFG_TUSB_MCU == OPT_MCU_RP2040) && !CFG_TUH_RPI_PIO_USB && !CFG_TUH_MAX3421
 
   #include "pico.h"
+  #include "hardware/timer.h" // PC3: time_us_32 for the EP0 RX-timeout grace window
 
   #if defined(PICO_RP2350) && PICO_RP2350 == 1
     #define HAS_STOP_EPX_ON_NAK
@@ -56,6 +57,19 @@
 static hw_endpoint_t  ep_pool[USB_MAX_ENDPOINTS];
 static hw_endpoint_t *epx = &ep_pool[0]; // current active endpoint
 
+/* PC3: EP0 RX-timeout grace window (usb/hcd_rp2040.patch).  A spurious
+ * RX_TIMEOUT can be the SIE's single shared handshake latch - ACK_REC /
+ * RX_TIMEOUT / DATA_SEQ_ERROR, one register for EPX and the interrupt-endpoint
+ * poller - overwritten by an interrupt-endpoint poll before this handler reads
+ * it (TinyUSB #3533): the control transfer was ACK'd on the bus, the latch
+ * says timeout.  Within the window the transfer is left armed and the
+ * clobbered result outlasted; the window closes on any EP0 completion.  A
+ * genuinely dead device expires it and takes the original failure path.
+ * Validated on the PicoMite tinyusb-0.21 tree and the PC3 MicroPython port,
+ * on this hardware. */
+static bool     pc3_rx_timing;
+static uint32_t pc3_rx_start_us;
+
   #ifndef HAS_STOP_EPX_ON_NAK
 static volatile bool epx_switch_request = false;
   #endif
@@ -235,6 +249,9 @@
 static void __tusb_irq_path_func(xfer_complete_isr)(hw_endpoint_t *ep, xfer_result_t xfer_result, bool is_more) {
   // Mark transfer as done before we tell the tinyusb stack
   uint32_t xferred_len = ep->xferred_len;
+  if (tu_edpt_number(ep->ep_addr) == 0) {
+    pc3_rx_timing = false; // close the EP0 RX-timeout grace window
+  }
   rp2usb_reset_transfer(ep);
   hcd_event_xfer_complete(ep->dev_addr, ep->ep_addr, xferred_len, xfer_result, true);
 
@@ -327,14 +344,39 @@
   if (status & USB_INTS_ERROR_RX_TIMEOUT_BITS) {
     usb_hw_clear->sie_status = USB_SIE_STATUS_RX_TIMEOUT_BITS;
 
-    const uint32_t sie_ctrl = (usb_hw->sie_ctrl & SIE_CTRL_BASE_MASK) | USB_SIE_CTRL_STOP_TRANS_BITS;
-    usb_hw->sie_ctrl        = sie_ctrl;
-    // while (usb_hw->sie_ctrl & USB_SIE_CTRL_STOP_TRANS_BITS) {}
-
-    // Even if STOP_TRANS bit is clear, controller maybe in middle of retrying and may re-raise timeout once extra time
-    // Only handle if epx is active, don't carry more epx transfer since STOP_TRANS is raced and not safe.
-    if (epx->state == EPSTATE_ACTIVE) {
-      xfer_complete_isr(epx, XFER_RESULT_FAILED, false);
+    /* PC3: grace period for control-pipe RX timeouts (see the note at
+     * pc3_rx_timing above).  EP0 only, within a bounded window: do not stop
+     * or fail the transfer - leave it armed and let the SIE retry, so a
+     * latch-clobbered timeout is simply outlasted and the transfer reads
+     * back correctly.  Bulk and interrupt keep the fast-fail below: their
+     * slow-path flow control is NAK, which never raises RX_TIMEOUT. */
+    bool pc3_in_grace = false;
+    if (epx->state == EPSTATE_ACTIVE && tu_edpt_number(epx->ep_addr) == 0) {
+      if (!pc3_rx_timing) {
+        pc3_rx_timing = true;
+        pc3_rx_start_us = time_us_32();
+      }
+      pc3_in_grace = (time_us_32() - pc3_rx_start_us) < 1000000u; // 1 s ceiling
+    }
+
+    if (!pc3_in_grace) {
+      const uint32_t sie_ctrl = (usb_hw->sie_ctrl & SIE_CTRL_BASE_MASK) | USB_SIE_CTRL_STOP_TRANS_BITS;
+      usb_hw->sie_ctrl        = sie_ctrl;
+      // while (usb_hw->sie_ctrl & USB_SIE_CTRL_STOP_TRANS_BITS) {}
+
+      // Even if STOP_TRANS bit is clear, controller maybe in middle of retrying and may re-raise timeout once extra time
+      // Only handle if epx is active, don't carry more epx transfer since STOP_TRANS is raced and not safe.
+      if (epx->state == EPSTATE_ACTIVE) {
+        /* PC3: the stopped transfer's buffer is still armed (AVAIL set) -
+         * the controller never completed it.  Left there, the next EPX
+         * transfer - usbh's retry of this very request - is refused by
+         * bufctrl_write32 with "buf_ctrl already available", which is a
+         * panic.  epx_save_context() clears it for the switch case; do
+         * the same for the failure case.  Seen at every boot on an
+         * RP2350 host behind a hub (a status-stage IN timing out). */
+        usbh_dpram->epx_buf_ctrl = 0;
+        xfer_complete_isr(epx, XFER_RESULT_FAILED, false);
+      }
     }
   }
 
