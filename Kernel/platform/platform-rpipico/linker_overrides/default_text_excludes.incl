/*
 * WHAT MAY EXECUTE FROM FLASH.
 *
 * The kernel used to be built PICO_COPY_TO_RAM, which put all 90,676
 * bytes of .text into RAM at boot.  RAM is the scarce thing here - it
 * is shared with the 308K process pool, and adding the text primitives
 * needed 4K taken off that pool - while flash sits at 22% used.
 *
 * The SDK's own mechanism does the work: its .data section (RAM) ends
 * with "*(.text*) ... *(.rodata*)" and the comment "stuff we exclude in
 * ..._excludes files because we want it in RAM".  So this file names
 * what goes to FLASH and everything it does not name falls through to
 * RAM.  The first matching output section wins, and flash comes first
 * in the script, so a name listed here is in flash and a name left out
 * is in RAM.
 *
 * -ffunction-sections is on, so this is per FUNCTION, by name, with no
 * source changes - which matters because 35 of the kernel's sources are
 * shared Fuzix core files that every other port compiles, and cannot
 * carry Pico SDK macros.
 *
 * ---------------------------------------------------------------
 * THE RULE FOR WHAT BELONGS HERE
 *
 * A function may run from flash if a cache miss on it cannot hurt.  It
 * must NOT be here if it is:
 *
 *   - on the scanout path.  core1 builds every scanline against a
 *     deadline; a miss there is a visible glitch.
 *   - an interrupt handler, or called from one.
 *   - reached while flash is busy.  Flash and PSRAM share the QMI, so
 *     kernel code fetched from XIP contends with the framebuffer layer
 *     and bcrun's heap.
 *   - part of the flash driver itself (rawflash, dhara, devflash): code
 *     that erases or programs flash cannot be executing from it.
 *
 * Good candidates are cold: boot and init, mode switching, the console
 * escape parser, anything that runs once or at human speed.
 *
 * And note that RAM is not automatically the fast choice here.  core1
 * DMAs scanlines out of disp_fb continuously, so RAM bandwidth is
 * contended, while the XIP cache is a separate path - a cached flash
 * fetch can beat a contended RAM one.  MMBasic's experience is the
 * same: pinning to RAM guarantees a floor, it does not guarantee a
 * win.  So the way to decide is to move something and measure it, not
 * to reason about it.
 *
 * ---------------------------------------------------------------
 * Whole objects can be moved with file patterns, which is how the bulk
 * of this is done; individual functions can be named where an object
 * is mixed hot and cold.
 *
 * See PC3-FLASH-PLAN.md for the triage and the measurements.
 */

/* ---- the filesystem: SD-backed, nowhere near the scanout ---- */
*filesys.c.o(.text*)
*inode.c.o(.text*)
*devio.c.o(.text*)
*blk512.c.o(.text*)
*mbr.c.o(.text*)

/* ---- system calls: entered from user code at human speed ---- */
*syscall_fs.c.o(.text*)
*syscall_fs2.c.o(.text*)
*syscall_fs3.c.o(.text*)
*syscall_other.c.o(.text*)
*syscall_proc.c.o(.text*)
*syscall_exec.c.o(.text*)
*syscall_execelf32.c.o(.text*)
*syscall_net.c.o(.text*)
*network.c.o(.text*)
*net_native.c.o(.text*)
*elf.c.o(.text*)

/* ---- boot and setup: once, before anything is timed ---- */
*start.c.o(.text*)
*devices.c.o(.text*)
*sound.c.o(.text*)
*board.c.o(.text*)
*ds3231.c.o(.text*)
*devgpio.c.o(.text*)
/* /dev/i2c.  A transaction is ~300us of bus at 400kHz, so where the
   dispatch runs is not measurable, and leaving these in RAM overflowed
   it by 248 bytes the moment they were added. */
*i2cuser.c.o(.text*)
*devi2c.c.o(.text*)

/* ---- the console's escape machinery and line editing, which run at
       terminal speed.  charout is per character so it is named back
       into RAM below if it ever measures badly. ---- */
*lineedit.c.o(.text*)
*kbd_decode.c.o(.text*)

/* ---- the kernel's printf: panics and boot messages ---- */
*printf.c.o(.text*)
*hexdump.c.o(.text*)

/* ---- the console: the escape parser, the tile/glyph plotting and
       charout.  charout is per CHARACTER, which is the one thing here
       that could have shown up, and it does not: the font and the code
       are both smaller than the 16K XIP cache, so a screen of text
       reads them from flash once.  Measured below. ---- */
*console.c.o(.text*)

/* ---- the shared maths library.
 *
 * This is here for USERLAND, not for the kernel, which does no
 * floating point of its own: libm_table.c exports it so that every
 * program can call one copy instead of linking its own 13K (see that
 * file).  In RAM it overflowed the region by 14,432 bytes; in flash it
 * costs nothing that matters, which is the entire point of sharing it.
 *
 * Nothing on the scanout path or in an interrupt calls these, and a
 * BASIC program's sin() is not on a deadline. ---- */
*libm.a:*(.text*)
*double_math.c.o(.text*)
*libm_table.c.o(.text*)

/* ---- the font table: two accessors, each called once per string
       rather than once per pixel.  The fonts themselves are `const' and
       so were never in RAM to begin with - that is the whole reason all
       nine of MMBasic's could be brought across. ---- */
*fonts.c.o(.text*)

/* ---- THE SCANOUT PATH IN FLASH: TRIED, AND IT KILLS THE DISPLAY ----
 *
 * disp_dma_irq and disp_fill_loop were moved here, on the reasoning
 * that MMBasic and MicroPython both run their interpreter from flash
 * through the XIP cache - so core0's instruction fetches never touch
 * SRAM there - while Fuzix executes user processes from the pool IN
 * main SRAM and starves core1.  Idle, it was clean and stable.  Under
 * load the picture vanished ENTIRELY the instant the program started.
 *
 * The reason is four paragraphs up this file: flash and PSRAM share the
 * QMI.  The load was mp3bench, which keeps 32K of decoder state in the
 * PSRAM arena and works it continuously, so core0's PSRAM traffic and
 * core1's instruction fetches were competing for one controller and
 * core1 simply stopped being fetched.
 *
 * So the rule at the top of this file stands, but for a sharper reason
 * than it gives: not "a cache miss might hurt" but "the scanout path
 * must not depend on the QMI, because anything using PSRAM will take
 * it away". ---- */

/* main.c is NOT here.  It raises clk_sys, and the code doing that
 * cannot be fetched from the flash whose clock it is changing - even
 * with pc3_clock_init doing the QMI work from RAM, the caller around
 * it would be running from flash across the switch. */

/* ---- SDK peripherals: NOT MOVED, and clocks.c is why. ----
 *
 * A batch of these was moved and the board hung stone dead - no boot,
 * no console, not even a panic.  clocks.c is the one that cannot go:
 * this board overclocks to 375 MHz, and set_sys_clock_khz reconfigures
 * the system clock, which changes the QMI's flash timing.  Code doing
 * that cannot be executing from the flash whose clock it is changing.
 * The SDK marks its own such functions __not_in_flash_func for exactly
 * this reason.
 *
 * flash.c is out for the same family of reasons - it is the flash
 * driver and cannot run from what it erases.
 *
 * The rest (i2c, pio, gpio, adc, uart, spi) are probably fine and
 * together are only about 3K.  They were moved as a speculative batch
 * with clocks.c, so they are untested, and they are not worth the
 * recovery cycle until something needs the space.
 */

/* ---- the SD card: polled SPI, not on the QMI at all ---- */
*blkdev.c.o(.text*)
*devsdspi.c.o(.text*)
*devsd.c.o(.text*)
*devsd_discard.c.o(.text*)

/* ---- /dev/sys ioctls: every one runs at human speed ---- */
*misc.c.o(.text*)

/* ---- the swapper: core0 only, nowhere near the scanout.  Its work
 * is memcpy between the pool and PSRAM, which goes through the QMI
 * regardless of where the code lives; the 1.7K of code itself fits
 * the XIP cache.  Moved for the same FS32 RAM squeeze as the batch
 * below. ---- */
*swapper.c.o(.text*)

/* ---- the SDK peripheral batch, moved when FS32 needed the space.
 *
 * This is the "not worth the recovery cycle until something needs the
 * space" batch from the note above, minus the members the rules
 * exclude: clocks.c and flash.c stay for the reasons given there,
 * uart.c stays because rawuart's receive interrupt calls into it, and
 * psram.c stays because it configures the QMI it would be fetched
 * through.  What moves is configuration-speed code: i2c (DS3231 and
 * the user i2c ioctls), pio and gpio setup, adc conversion setup, and
 * the spi block driver under the SD card (whose C callers already run
 * from flash).  ~6K.  FS32's 256-byte in-core inodes are what needed
 * it: ITABSIZE x 192 extra bytes overflowed RAM by 10K. ---- */
*hardware_i2c/i2c.c.o(.text*)
*hardware_pio/pio.c.o(.text*)
*hardware_gpio/gpio.c.o(.text*)
*hardware_adc/adc.c.o(.text*)
*hardware_spi/spi.c.o(.text*)
