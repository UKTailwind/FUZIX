# The compiler passes hosted on the ARM Fuzix machine.
#
# cc1 now uses the real ARM type model (ILP32) via target-thumb.c.
# cc2 is still the Z80 backend and therefore emits nonsense for this
# machine - it is a placeholder so the build links, and phase 2 of
# PC3-COMPILER-PLAN.md replaces it with the bytecode emitter.
#
# For development, Makefile.host builds cc0/cc1 as native binaries so
# the front end can be run over real source without hardware.
SRC_C1 = target-thumb.c
SRC_C2 = backend-z80.c

FLOAT = -DNO_FLOAT

include Makefile.common

# Stage 1: no on-target Z80 runtime libs; the passes are the experiment
support:
	@:
