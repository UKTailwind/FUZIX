ROOT = ../..
# The platform "world" target runs this makefile directly, where the top
# level's exported FUZIX_ROOT is not in scope. Without it rules.armm0
# builds -isystem /Library/include and everything compiles silently
# against newlib, failing only at link with _impure_ptr and friends.
FUZIX_ROOT ?= $(ROOT)
include $(ROOT)/Target/rules.armm0

CSRCS = beep.c blockio.c display.c doscall.c editcor.c exec.c find.c
CSRCS += flexcall.c gemcall.c globals.c insert.c main.c misc.c modify.c
CSRCS += move.c rmxcall.c ucsd.c undo.c unixcall.c wildargs.c
HDRS  = extern.h grep.h levee.h proto.h

OBJS = $(CSRCS:.c=.o)

all: levee

levee: $(OBJS) $(CRT0)
	$(LINKER) -o levee.debug $(CRT0) $(OBJS) $(LINKER_OPT)
	$(STRIP) $(STRIP_OPT) -o $@ $@.debug

# SIZE is levee's whole edit buffer, and its default of 4096 makes the
# editor useless for anything but a short script: a larger file opens
# READ-ONLY with "[overflow]" and :w answers "File is readonly".  It is
# #ifndef-guarded in levee.h precisely so a port can choose, and this
# one can afford to - core[] is BSS in a process that may have ~292K of
# a 340K pool, and levee is short-lived.  64K covers any source file
# anyone will reasonably edit on the machine.  Every index into the
# buffer is a plain int, which is 32 bits here, so the arithmetic has
# room to spare.
.c.o:
	$(CC) $(CFLAGS) $(COPT) -c -DVT52=0 -DANSI=1 -DSIZE=65536 -o $@ $<

clean:
	rm -rf $(OBJS) *.lst *.sym *.map *.noi *.lk *.ihx *.tmp *~ *.o *.rel *.asm
	rm -f levee *.bin levee-termcap
