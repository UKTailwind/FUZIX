-- one dimension
bound      4
values     0 1 4 9 16
-- two dimensions, row-major like every other array
bounds     4 2
g(3,2)     32
g(0,0)     0
g(4,2)     42
-- strings
s$(2)     item2
s$(4)     item4
-- a whole array still passes to a SUB
sum        30
-- MATH works on it too
after set  7 7
-- REDIM discards, REDIM PRESERVE keeps
grown      6 : 1 2 3 4 0 0 0
shrunk     2 : 1 2 3
plain      4 : 0 0 0 0 0
-- ERASE really gives a run-time array back
erased     0
-- and it works inside a SUB, per invocation
local 3  bound 3 last 3
local 6  bound 6 last 6
