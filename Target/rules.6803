CC = fcc -m6803
AS = fcc -m6803
LINKER = $(FUZIX_ROOT)/Library/link/ld6803
CFLAGS = -O -X -m6803 -D__STDC__ -c -I$(FUZIX_ROOT)/Library/include -I$(FUZIX_ROOT)/Library/include/6803
LINKER_OPT =
LINKER_TAIL = -L $(FUZIX_ROOT)/Library/libs -lc6803 -M
AS_OPT = -o
CRT0 = $(FUZIX_ROOT)/Library/libs/crt0_6803.o
CRT0NS = $(FUZIX_ROOT)/Library/libs/crt0nostdio_6803.o
HOSTCC = cc
.SUFFIXES: .c .o

