CC = fcc
AS = fcc -mtms7000
LINKER = $(FUZIX_ROOT)/Library/link/ldtms7000
CFLAGS = -X -mtms7000 -Os -D__STDC__ -c -I$(FUZIX_ROOT)/Library/include -I$(FUZIX_ROOT)/Library/include/tms7000
#CFLAGS = -X -mtms7000 -D__STDC__ -c -I$(FUZIX_ROOT)/Library/include #-I$(FUZIX_ROOT)/Library/include/tms7000
LINKER_OPT = -L$(FUZIX_ROOT)/Library/libs
LINKER_TAIL = -lctms7000
ASM_OPT = -o
CRT0 = $(FUZIX_ROOT)/Library/libs/crt0_tms7000.o
CRT0NS = $(FUZIX_ROOT)/Library/libs/crt0nostdio_tms7000.o
HOSTCC = cc
.SUFFIXES: .c .o .y
