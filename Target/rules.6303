CC = fcc -m6303
AS = fcc -m6303
LINKER = $(FUZIX_ROOT)/Library/link/ld6303
CFLAGS = -X -m6303 -D__STDC__ -c -I$(FUZIX_ROOT)/Library/include -I$(FUZIX_ROOT)/Library/include/6303
LINKER_OPT =
LINKER_TAIL = -L $(FUZIX_ROOT)/Library/libs -lc6303 -M
AS_OPT = -o
CRT0 = $(FUZIX_ROOT)/Library/libs/crt0_6303.o
CRT0NS = $(FUZIX_ROOT)/Library/libs/crt0nostdio_6303.o
HOSTCC = cc
.SUFFIXES: .c .o

