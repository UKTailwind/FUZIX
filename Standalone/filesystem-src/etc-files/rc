umask 022
fsck -a -y /
setdate
remount -n / rw
prtroot >/etc/mtab
# No swapon. Swap is not a device any more: the kernel allocates a
# region the size of the process out of the PSRAM heap and memcpy's
# into it, so nothing here has to know a size.
# USB keyboard layout: us uk de fr es be
picoctl keymap uk
# Num lock belongs to the KEYBOARD: one with no numeric keypad (a
# Raspberry Pi keyboard, most laptop-style boards) types digits for
# 7890/uiop/jkl;/m while it is on. The kernel turns it off by itself for
# a keyboard that declares no num lock LED, but plenty of keypad-less
# keyboards declare one anyway - so "picoctl numlock off" records the
# answer per keyboard in /etc/numlock and this replays it at boot. The
# kernel does not write files; that file is the whole of the memory.
picoctl numlock --load
#Uncomment if you have multiple file systems
